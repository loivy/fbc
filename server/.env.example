# Local dev only. On Cloud Run these are unnecessary (ADC + injected PORT are automatic).
PORT=8080
# Comma-separated list of allowed browser origins.
# In production this must include BOTH Firebase Hosting domains:
#   https://<project>.web.app,https://<project>.firebaseapp.com
CLIENT_ORIGIN="http://localhost:5173"
FIREBASE_PROJECT_ID="fbc-dev"
# Point this at a downloaded service account key OR run:
#   gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
