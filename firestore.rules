rules_version = '2';

// All reads/writes go through the Cloud Run API using the Admin SDK, which
// bypasses these rules. Direct client access to Firestore is denied so that
// role checks and business logic (e.g. founder tier changes) can't be
// bypassed by calling Firestore straight from the browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
